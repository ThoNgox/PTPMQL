@model MvcMovie.Models.Person
@{
    ViewData["Title"] = "Thong tin ca nhan";

}
<h1>Nhap thong tin ca nhan</h1>
<form action="Index" method="post">
    <div>
        <label for="FullName">Ho va ten</label>
        <input type="text" name="FullName" required>
    </div>
    <div>
        <label for="YearOfBirth">Nam sinh</label>
        <input type="number" name="YearOfBirth" required>
    </div>
    <button type="submit">gui</button>
</form>
@if (ViewBag.FullName !=null)
{
    <h2>Ket qua</h2>
    <h3>Xin chao @ViewBag.FullName</h3>
    <h3>ban nam nay @ViewBag.Age tuoi</h3>
}